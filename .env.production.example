# ==============================================================================
# LOGICORE by HAMEED - PRODUCTION ENVIRONMENT VARIABLES (.env.production)
# ==============================================================================

NODE_ENV="production"
PORT=3000

# 1. Production Public App Domain (Replace with your Vercel or Custom Domain)
NEXT_PUBLIC_APP_URL="https://logicore-by-hameed.vercel.app"

# 2. Production Managed Database (Supabase / Neon / Render PostgreSQL)
# Example Supabase pooled connection string:
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# 3. NextAuth Production Security
NEXTAUTH_URL="https://logicore-by-hameed.vercel.app"
NEXTAUTH_SECRET="SUPER_STRONG_64_CHAR_HEX_KEY_FOR_PRODUCTION_SESSION_ENCRYPTION"
JWT_SECRET="ROTATING_PRODUCTION_JWT_SECRET_KEY_SHA256"
BCRYPT_SALT_ROUNDS=12

# 4. Super Admin Credentials (Eng. Hameed)
ADMIN_EMAIL="hameed@industrial-academy.iq"
ADMIN_INITIAL_PASSWORD="HameedAdmin2026!#"

# 5. Middle East & International Payment Gateway Credentials
ZAIN_CASH_MERCHANT_ID="YOUR_PRODUCTION_ZAIN_CASH_MERCHANT_ID"
ZAIN_CASH_SECRET="YOUR_PRODUCTION_ZAIN_CASH_SECRET"
ZAIN_CASH_MSISDN="9647800000000"
ZAIN_CASH_ENV="production"

FIB_CLIENT_ID="YOUR_PRODUCTION_FIB_CLIENT_ID"
FIB_CLIENT_SECRET="YOUR_PRODUCTION_FIB_CLIENT_SECRET"
FIB_API_BASE_URL="https://api.fib.iq"

STRIPE_PUBLIC_KEY="pk_live_your_live_stripe_public_key"
STRIPE_SECRET_KEY="sk_live_your_live_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_live_stripe_webhook_secret"

# 6. Industrial Safety Interlock (Must remain strictly FALSE for public cloud)
IIOT_HARDWARE_WRITE_ENABLED=false
IIOT_READ_ONLY_MODE=true
