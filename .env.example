# ==============================================================================
# INDUSTRIAL AUTOMATION ACADEMY - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 1. Database (PostgreSQL / Supabase / Neon / Render)
# LMS database is strictly isolated from any operational plant data
DATABASE_URL="postgresql://postgres:industrial_secure_pass_2026@localhost:5432/industrial_automation_db?schema=public"
DIRECT_URL="postgresql://postgres:industrial_secure_pass_2026@localhost:5432/industrial_automation_db?schema=public"

# 2. NextAuth & Cybersecurity (OWASP Top 10)
# Generate 64-character random key: openssl rand -base64 48
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="insecure_local_dev_secret_change_in_production_min_64_chars_hex_industrial_lms_2026"
JWT_SECRET="industrial_jwt_rotation_key_sha256_super_secure_protection"
BCRYPT_SALT_ROUNDS=12

# 3. Super Admin Initial Credentials (Hameed)
ADMIN_EMAIL="hameed@industrial-academy.iq"
ADMIN_INITIAL_PASSWORD="ChangeMe_StrictPassword2026!#"

# 4. Rate Limiting Protection (Upstash Redis or In-Memory)
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60

# 5. Middle East & International Payment Gateway Stubs
# Zain Cash (Iraq) API Credentials
ZAIN_CASH_MERCHANT_ID="stub_zain_merchant_id"
ZAIN_CASH_SECRET="stub_zain_secret_key"
ZAIN_CASH_MSISDN="9647800000000"
ZAIN_CASH_ENV="test" # test or production

# First Iraqi Bank (FIB) Business API
FIB_CLIENT_ID="stub_fib_client_id"
FIB_CLIENT_SECRET="stub_fib_client_secret"
FIB_API_BASE_URL="https://api.fib.iq/test"

# Stripe (Fallback International)
STRIPE_PUBLIC_KEY="pk_test_industrial_sample_key"
STRIPE_SECRET_KEY="sk_test_industrial_sample_key"
STRIPE_WEBHOOK_SECRET="whsec_industrial_sample_key"

# 6. Future IIoT Hardware Bridge (Isolated Local Gateway Architecture)
# STRICT SAFETY CONSTRAINTS:
# 1. Web application runs in simulation mode by default.
# 2. HARDWARE_WRITE_ENABLED must remain FALSE for public web requests.
# 3. Physical connectivity requires Local VPN + Physical E-Stop relay circuit.
IIOT_LOCAL_GATEWAY_URL="ws://127.0.0.1:1880/industrial-plc-stream"
IIOT_GATEWAY_AUTH_KEY="local_shared_hmac_secret_not_exposed_to_public"
IIOT_HARDWARE_WRITE_ENABLED=false
IIOT_READ_ONLY_MODE=true
IIOT_ALLOWED_LOCAL_SUBNET="192.168.1.0/24"
